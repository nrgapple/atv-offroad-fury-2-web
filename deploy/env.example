# /etc/fury-server/env: settings for fury-server (research/GAME_SERVER.md).
# No secrets belong here: TLS keys are issued in process and cached in
# FURY_ACME_CACHE. cloud-init writes this file from deploy/cloud-init.yaml.

# Public address. The DNS record is IPv4 only (a reserved IP), so 0.0.0.0.
FURY_LISTEN=0.0.0.0:443
FURY_ALLOWED_ORIGINS=https://furyremastered.com,https://www.furyremastered.com,https://atv-offroad-fury-2.champtoday.workers.dev,https://mp.furyremastered.com

# Let's Encrypt over TLS-ALPN-01 on port 443 (no port 80 needed).
FURY_TLS=acme
FURY_ACME_DOMAINS=mp.furyremastered.com
# Optional ACME account contact (expiry notices); provision.sh --acme-email sets it.
# FURY_ACME_EMAIL=ops@example.com
FURY_ACME_CACHE=/var/lib/fury-server/acme
# FURY_TLS=files instead reads PEM files:
# FURY_TLS_CERT=/etc/fury-server/cert.pem
# FURY_TLS_KEY=/etc/fury-server/key.pem

FURY_STATE_DIR=/var/lib/fury-server/state

# Client addresses or CIDR blocks (IPv4/IPv6, comma-separated) that play
# normally but stay out of the public rider and room counts: the owner's
# test machines. Set it on the host only; never commit real addresses.
FURY_UNCOUNTED_IPS=
# FURY_COMMIT is not set here: each release directory carries release.env
# (FURY_COMMIT=<commit>), which the unit reads after this file.
RUST_LOG=info
