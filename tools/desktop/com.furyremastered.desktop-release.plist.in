<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template for a LaunchAgent that builds and publishes desktop archives when a
     desktop-v* tag is pushed. Replace @REPO@ (the shared checkout), @HOME@ and install per
     research/DESKTOP_RELEASES.md. Not installed by default. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.furyremastered.desktop-release</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>@REPO@/tools/desktop_release_watcher.py</string>
    <string>--repo</string><string>@REPO@</string>
  </array>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><false/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>@HOME@/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key><string>@HOME@/LargeFiles/fury-desktop/watcher.log</string>
  <key>StandardErrorPath</key><string>@HOME@/LargeFiles/fury-desktop/watcher.log</string>
</dict>
</plist>
