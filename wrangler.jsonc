{
  "$schema": "https://unpkg.com/wrangler@4.149.0/config-schema.json",
  "name": "atv-offroad-fury-2",
  "main": "cloudflare/entry.mjs",
  "compatibility_date": "2026-10-01",
  "account_id": "92b7e16fd24d5fb585f866f5832a032b",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "work/cloudflare/static",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "CONTENT",
      "bucket_name": "atv-offroad-fury-2-content"
    }
  ],
  "vars": {
    "GAME_ORIGIN": "https://furyremastered.com",
    "GAME_ORIGINS": "https://furyremastered.com,https://atv-offroad-fury-2.champtoday.workers.dev",
    "CANONICAL_ORIGIN": "https://furyremastered.com",
    "MULTIPLAYER_GUARDS": "required"
  },
  "analytics_engine_datasets": [
    {
      "binding": "USAGE",
      "dataset": "fury_usage"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LOBBIES",
        "class_name": "LobbyRoom"
      },
      {
        "name": "ADMISSION",
        "class_name": "LobbyAdmission"
      }
    ]
  },
  "migrations": [
    {
      "tag": "rust-lobbies-v1",
      "new_sqlite_classes": [
        "LobbyRoom"
      ]
    },
    {
      "tag": "admission-budget-v1",
      "new_sqlite_classes": [
        "LobbyAdmission"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "furyremastered.com",
      "zone_id": "ea0921ec471b2a7de78838cdbaeccb78",
      "custom_domain": true
    },
    {
      "pattern": "www.furyremastered.com",
      "zone_id": "ea0921ec471b2a7de78838cdbaeccb78",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "redact_query_string": true
  },
  "ratelimits": [
    {
      "name": "ROOM_CREATE_LIMIT",
      "namespace_id": "82401301",
      "simple": {
        "limit": 12,
        "period": 60
      }
    },
    {
      "name": "ROOM_CONNECT_LIMIT",
      "namespace_id": "82401302",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "EVENT_LIMIT",
      "namespace_id": "82401303",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
